# Copy to `.env` and fill in real values — never commit `.env` itself.
#
# Run with:
#   flutter run --dart-define-from-file=.env
#
# See AGENT.md for details on what each value gates.

# Base URL for Hazy's /v1/** backend (a standalone Cloudflare Worker,
# apps/api in the hazy repo — not the Next.js web app).
# Local dev against `apps/api`'s dev server (`bun run dev`, port 8787) on
# the same machine, from the Android emulator: http://10.0.2.2:8787/v1
# (this is also the built-in default if HAZY_API_BASE_URL is left unset
# entirely).
# Physical device on the same LAN: http://<host-machine-LAN-IP>:8787/v1
# Deployed backend: https://api.hz.nknighta.me/v1
HAZY_API_BASE_URL=http://10.0.2.2:8787/v1

# Clerk publishable key for this project's Clerk instance (starts with
# pk_test_ or pk_live_). Ask the project owner. Without this, the app shows
# a "not configured" screen instead of initializing the Clerk SDK.
CLERK_PUBLISHABLE_KEY=
